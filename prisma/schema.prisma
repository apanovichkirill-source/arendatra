generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryGroup {
  LIFTING // грузоподъёмная техника
  EARTHMOVING // землеройная техника
  PASSENGER // пассажирские перевозки
}

enum BookingStatus {
  NEW
  CONFIRMED
  DONE
  CANCELED
}

model Buyer {
  id             String    @id @default(cuid())
  phone          String    @unique
  passwordHash   String
  name           String?
  city           String?
  organization   String?
  createdAt      DateTime  @default(now())
  consentAt      DateTime?
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLat        Float?
  lastLng        Float?
  lastGeoCity    String?
  lastGeoAt      DateTime?

  bookings Booking[]

  @@map("buyers")
}

model Admin {
  id             String    @id @default(cuid())
  login          String    @unique
  passwordHash   String
  name           String?
  createdAt      DateTime  @default(now())
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  // главный администратор: полный доступ, управляет остальными аккаунтами
  isSuper        Boolean   @default(false)
  isActive       Boolean   @default(true)
  // ключи прав, например "vehicles.view", "vehicles.edit" (см. src/lib/admin-permissions.ts)
  permissions    String[]  @default([])
  // сессии, выданные раньше этой даты, недействительны (смена/сброс пароля)
  passwordChangedAt DateTime?

  @@map("admins")
}

// Журнал аудита. adminId без внешнего ключа: записи остаются после удаления аккаунта.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  adminId    String?
  adminLogin String
  action     String
  entityType String?
  entityId   String?
  details    String?
  ip         String?

  @@map("audit_logs")
  @@index([createdAt])
  @@index([adminId])
}

// Лимит запросов по ключу (например "register:1.2.3.4") в скользящем окне времени
model RateLimit {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@map("rate_limits")
}

model Owner {
  id          String   @id @default(cuid())
  name        String
  description String?
  phone       String?
  email       String?
  city        String?
  address     String?
  logoUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vehicles Vehicle[]

  @@map("owners")
}

model Category {
  id        String        @id @default(cuid())
  group     CategoryGroup
  name      String
  slug      String        @unique
  sortOrder Int           @default(0)

  vehicles Vehicle[]

  @@map("categories")
}

model Vehicle {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String?
  pricePerHour  Decimal? @db.Decimal(12, 2)
  minHours      Int      @default(1)
  imageUrl      String?
  city          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // произвольные характеристики (год, коробка, топливо, мест, грузоподъёмность и т.п.)
  attributes Json?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  ownerId String
  owner   Owner  @relation(fields: [ownerId], references: [id])

  bookings Booking[]

  @@map("vehicles")
  @@index([categoryId])
  @@index([ownerId])
}

model Booking {
  id           String        @id @default(cuid())
  status       BookingStatus @default(NEW)
  comment      String?
  contactPhone String
  contactName  String?
  startAt      DateTime
  endAt        DateTime
  totalPrice   Decimal?      @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  consentAt    DateTime?
  geoLat       Float?
  geoLng       Float?

  buyerId String?
  buyer   Buyer? @relation(fields: [buyerId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  @@map("bookings")
  @@index([vehicleId])
  @@index([buyerId])
}
